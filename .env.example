# PostgreSQL (Neon). Pooled URL for the app, direct URL for `prisma db push`.
# On Vercel these are set by the Neon integration; locally use the snav-db-dev database.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Public URL of the site (used in emails)
NEXT_PUBLIC_SITE_URL="https://snavindia.com"

# Razorpay (optional). Without keys, bookings are placed as requests and paid offline.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Email via Resend (optional). Without a key, emails are logged to the console.
RESEND_API_KEY=""
EMAIL_FROM="SNAV <no-reply@snavindia.com>"
ADMIN_EMAIL=""

# File uploads in production (Vercel Blob). Without it, files are stored in ./storage.
BLOB_READ_WRITE_TOKEN=""

# Protects the daily reminder cron endpoint
CRON_SECRET=""

# Seed: first admin login (a random password is generated if empty)
SEED_ADMIN_EMAIL="admin@snavindia.com"
SEED_ADMIN_PASSWORD=""
